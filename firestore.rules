rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{uid} {
      allow read, write: if false;
    }

    match /memberOwners/{uid} {
      allow read, write: if false;
    }

    match /usernames/{name} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
