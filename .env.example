# ID project Firebase server yang menyimpan Firestore.
FIREBASE_PROJECT_ID=

# Firebase service account; server-only, required for certificate-validated card saves.
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Cloudflare Turnstile: site key publik dan secret key khusus server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL publik situs, misalnya https://kartu.example.com.
NEXT_PUBLIC_SITE_URL=

# Cookie sesi Facebook, hanya dipakai route server untuk scraping data profil/grup.
# Simpan sebagai rahasia, jangan beri prefix NEXT_PUBLIC_.
COOKIE=
COOKIE1=

# Notifikasi kegagalan scraper ke chat pribadi owner.
# Buat bot melalui @BotFather dan isi chat ID owner (bukan username Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
